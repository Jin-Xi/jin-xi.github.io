---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = Map.groupBy(posts, (post) => post.data.date.getFullYear());
---

<BaseLayout title="归档" description="Jin Xi 的学习日志归档">
  <section class="page-head wrap"><p class="eyebrow">ARCHIVE</p><h1>归档</h1><p>按时间回看走过的学习路径。</p></section>
  <section class="archive-list wrap">
    {[...groups.entries()].map(([year, yearPosts]) => (
      <div class="archive-year">
        <h2>{year}</h2>
        <div>{yearPosts.map((post) => <a href={`/${post.data.path}/`}><time>{post.data.date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}</time><span>{post.data.title}</span><i>→</i></a>)}</div>
      </div>
    ))}
  </section>
</BaseLayout>
