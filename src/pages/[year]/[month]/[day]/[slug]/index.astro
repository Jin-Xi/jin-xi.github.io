---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => {
    const [year, month, day, ...slug] = post.data.path.split("/");
    return { params: { year, month, day, slug: slug.join("/") }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article wrap">
    <header>
      <p class="eyebrow">{post.data.type.toUpperCase()} · {post.data.date.toLocaleDateString("zh-CN", { timeZone: "Asia/Shanghai", year: "numeric", month: "long", day: "numeric" })}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="tag-row">{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>
    </header>
    <div class="prose"><Content /></div>
    <footer><a href="/">← 回到时间线</a><span>学习是给未来的自己留下路标。</span></footer>
  </article>
</BaseLayout>
